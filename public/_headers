# Cabeçalhos de segurança para hospedagens estáticas que leem este arquivo (Netlify, Cloudflare Pages).
# A CSP também vai no <meta> do index.html; aqui ela ganha frame-ancestors, que <meta> não aceita.
# connect-src: API de IA (Render) e Supabase do app; img-src: Supabase (URLs assinadas). Troque se mudar de projeto.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://mfngcmjgisfgttsgqyfl.supabase.co; font-src 'self'; connect-src 'self' https://greenleaf-ia.onrender.com https://mfngcmjgisfgttsgqyfl.supabase.co; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
  Cross-Origin-Opener-Policy: same-origin

/sw.js
  Cache-Control: no-cache
