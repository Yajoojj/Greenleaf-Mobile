# GreenLeaf — variáveis públicas (vão para o navegador: NUNCA coloque segredos aqui).

# URL do módulo de IA (GreenLeaf IA v2 na Render). Sem ela, o app usa o MockPredictionService.
# Em produção precisa ser https:// — http:// só é aceito em desenvolvimento (localhost).
# VITE_API_URL=https://greenleaf-ia.onrender.com

# Back-end do app (Supabase: contas, histórico na nuvem, feedback e mapa de calor).
# Sem as duas, o app usa contas e histórico só no aparelho (mocks), exatamente como antes.
# Use a chave ANÔNIMA/PUBLICÁVEL. A chave service role (ou sb_secret_...) é recusada pelo app
# e nunca deve sair do servidor do Supabase.
# VITE_SUPABASE_URL=https://mfngcmjgisfgttsgqyfl.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Recursos futuros (true/false)
VITE_FEATURE_GEOLOCATION=false
VITE_FEATURE_HEATMAP=false
